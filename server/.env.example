# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (choose one database type)
MONGODB_URI=mongodb://localhost:27017/fullstack-starter

# PostgreSQL Configuration (choose one database type)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fullstack_starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT Configuration (for future authentication implementation)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
